{
  "name": "@aemeath-projects/wuwa-fonts",
  "version": "1.0.0",
  "description": "鸣潮字体库",
  "main": "index.css",
  "scripts": {
    "commit": "cz",
    "bump": "commit-and-tag-version",
    "bump:patch": "commit-and-tag-version --release-as patch",
    "bump:minor": "commit-and-tag-version --release-as minor",
    "bump:major": "commit-and-tag-version --release-as major",
    "prepare": "husky"
  },
  "keywords": [
    "fontsource",
    "font",
    "font family",
    "solaris-universal",
    "Solaris Universal",
    "digital-tube",
    "Digital Tube",
    "rinascita-ribbon",
    "Rinascita Ribbon",
    "old-font",
    "Old Font",
    "lahai-roi",
    "Lahai-Roi",
    "ragunna",
    "Ragunna",
    "septimont",
    "Septimont",
    "css",
    "sass",
    "front-end",
    "web",
    "typeface"
  ],
  "exports": {
    ".": {
      "sass": "./index.css",
      "default": "./index.css"
    },
    "./*.css": {
      "sass": "./*.css",
      "default": "./*.css"
    },
    "./*": {
      "sass": "./*.css",
      "default": "./*.css"
    },
    "./LICENSE": "./LICENSE",
    "./README.md": "./README.md",
    "./package.json": "./package.json",
    "./metadata.json": "./metadata.json",
    "./unicode.json": "./unicode.json",
    "./scss": {
      "sass": "./scss/metadata.scss"
    },
    "./files/*": {
      "sass": "./files/*",
      "default": "./files/*"
    },
    "./files/*.woff": {
      "sass": "./files/*.woff",
      "default": "./files/*.woff"
    },
    "./files/*.woff2": {
      "sass": "./files/*.woff2",
      "default": "./files/*.woff2"
    }
  },
  "author": "Aemeath Projects",
  "license": "MIT",
  "homepage": "https://aemeath.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/aemeath-projects/wuwa-fonts.git"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "commit-and-tag-version": "^13.3.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7"
  }
}
